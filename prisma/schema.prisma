generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum DataStatus {
  VERIFIED
  ESTIMATED
  UNKNOWN
}

model Market {
  version          Int          @default(0)
  id               Int          @id @default(autoincrement())
  code             String       @unique
  name             String
  currency         String       @default("USD")
  countryCode      String?
  pricesIncludeTax Boolean      @default(false)
  // Default assumptions for this market: { [inputKey]: { value, status, note } }
  assumptions      Json         @default("{}")
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  evaluations      Evaluation[]
  evidence         Evidence[]
  shippingQuotes   ShippingQuote[]
  competitors      CompetitorObservation[]
  offers           ExternalOffer[]
}

model Opportunity {
  id          Int          @id @default(autoincrement())
  name        String
  category    String?
  sourceName  String?
  sourceUrl   String?
  notes       String?
  isSample    Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  evaluations Evaluation[]
  listings    SourceListing[]
  competitors CompetitorObservation[]
  offers      ExternalOffer[]
  evidence    Evidence[]
}

model Evaluation {
  version       Int         @default(0)
  id            Int         @id @default(autoincrement())
  opportunityId Int
  marketId      Int
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  market        Market      @relation(fields: [marketId], references: [id], onDelete: Restrict)
  inputs        CostInput[]

  @@unique([opportunityId, marketId])
}

// value: money = minor units (cents), percent = basis points, count = whole number
model CostInput {
  id           Int        @id @default(autoincrement())
  evaluationId Int
  key          String
  value        Int?
  status       DataStatus @default(UNKNOWN)
  note         String?
  updatedAt    DateTime   @updatedAt
  evaluation   Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)

  @@unique([evaluationId, key])
}

// A catalogue record is a candidate, not proof of demand or profit.
model SourceListing {
  id            Int      @id @default(autoincrement())
  provider      String
  externalId    String
  variantId     String   @default("")
  name          String
  url           String
  currency      String
  priceMinor    Int?
  observedAt    DateTime
  importedVia   String @default("MANUAL_IMPORT")
  opportunityId Int?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  observations  ListingObservation[]
  variants      SupplierVariant[]
  identity      ListingIdentity?
  @@unique([provider, externalId, variantId])
}

// Operator-entered identifiers; catalogue refreshes never overwrite these.
model ListingIdentity {
  listingId Int @id
  listing SourceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  revision Int
  gtin String?
  brand String?
  mpn String?
  packUnits Int?
  variantKey String?
  sourceUrl String
  observedAt DateTime
  note String
  updatedAt DateTime @updatedAt
  @@index([gtin])
  @@index([brand, mpn])
}

// Immutable snapshots survive deletion of a catalogue row or opportunity.
model IdentityRevision {
  id Int @id @default(autoincrement())
  listingId Int
  revision Int
  snapshot Json
  createdAt DateTime @default(now())
  @@unique([listingId, revision])
}

model ListingLinkDecision {
  id Int @id @default(autoincrement())
  listingId Int
  opportunityId Int
  kind String
  note String
  snapshot Json
  createdAt DateTime @default(now())
  @@index([listingId, createdAt])
}

model ListingObservation {
  id         Int @id @default(autoincrement())
  listingId  Int
  listing    SourceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  priceMinor Int?
  currency   String
  observedAt DateTime
  importedVia String @default("MANUAL_IMPORT")
  @@unique([listingId, observedAt])
}

model ImportRun {
  id          Int @id @default(autoincrement())
  source      String
  created     Int
  updated     Int
  unchanged   Int
  completedAt DateTime @default(now())
}

model Evidence {
  resolvedAt    DateTime?
  resolutionNote String?
  id            Int @id @default(autoincrement())
  opportunityId Int
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  marketId      Int?
  market        Market? @relation(fields: [marketId], references: [id], onDelete: Restrict)
  kind          String
  provenance    String
  summary       String
  url           String
  observedAt    DateTime
  expiresAt     DateTime
  outcome       String
  createdAt     DateTime @default(now())
}

model SupplierVariant {
  id          Int @id @default(autoincrement())
  listingId   Int
  listing     SourceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  externalId  String
  name        String
  sku         String?
  priceMinor  Int?
  origins     Json
  observedAt  DateTime
  active      Boolean @default(true)
  quotes      ShippingQuote[]
  @@unique([listingId, externalId])
}

// Quotes are immutable snapshots of one variant, one unit and one route.
model ShippingQuote {
  id                  Int @id @default(autoincrement())
  variantId           Int
  variant             SupplierVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  marketId            Int
  market              Market @relation(fields: [marketId], references: [id], onDelete: Restrict)
  originCountry       String
  destinationCountry  String
  postalCode          String
  method              String
  deliveryEstimate    String?
  productPriceMinor   Int?
  productObservedAt   DateTime?
  shippingMinor       Int
  taxesMinor          Int?
  clearanceMinor      Int?
  totalPostageMinor   Int?
  observedAt          DateTime
  expiresAt           DateTime
  @@index([variantId, observedAt])
}

model CompetitorObservation {
  importedOffer ExternalOffer?
  id            Int @id @default(autoincrement())
  opportunityId Int
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  marketId      Int
  market        Market @relation(fields: [marketId], references: [id], onDelete: Restrict)
  merchant      String
  url           String
  match         String
  comparison    String
  priceMinor    Int
  shippingMinor Int?
  currency      String
  taxBasis      String
  observedAt    DateTime
  expiresAt     DateTime
  @@unique([opportunityId, marketId, url, observedAt])
}

model DiscoverySchedule {
  id          Int @id @default(autoincrement())
  keyword     String @unique
  intervalHours Int @default(24)
  enabled     Boolean @default(false)
  nextRunAt   DateTime @default(now())
  leaseUntil  DateTime?
  leaseToken  String?
  failures    Int @default(0)
  createdAt   DateTime @default(now())
  executions  DiscoveryExecution[]
}

model DiscoveryExecution {
  id          Int @id @default(autoincrement())
  scheduleId  Int
  schedule    DiscoverySchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  state       String
  startedAt   DateTime @default(now())
  finishedAt  DateTime?
  message     String?
  created     Int @default(0)
  updated     Int @default(0)
  unchanged   Int @default(0)
  @@index([state, startedAt])
}

model DiscoveryWorkerStatus {
  id          String @id
  lastSeenAt  DateTime
}

model FxSnapshot {
  id           Int @id @default(autoincrement())
  provider     String
  currency     String
  rate         String
  rateDate     DateTime
  retrievedAt  DateTime @default(now())
  sourceUrl    String
  @@unique([provider, currency, rateDate, rate])
}

model ExternalOffer {
  id            Int @id @default(autoincrement())
  opportunityId Int
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  marketId      Int
  market        Market @relation(fields: [marketId], references: [id], onDelete: Restrict)
  provider      String
  externalId    String
  title         String
  merchant      String
  url           String
  priceMinor    Int
  currency      String
  destinationCountry String
  observedAt    DateTime
  expiresAt     DateTime
  state         String @default("PENDING")
  reviewNote    String?
  observationId Int? @unique
  observation   CompetitorObservation? @relation(fields: [observationId], references: [id], onDelete: SetNull)
  @@unique([opportunityId, marketId, provider, externalId])
}

model OwnerSession {
  id              String @id
  passwordVersion String
  expiresAt       DateTime
  @@index([expiresAt])
}
model OwnerLoginState {
  id              String @id
  failures        Int @default(0)
  windowStartedAt DateTime
  lockedUntil     DateTime?
}
